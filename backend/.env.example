# Application Configuration
APP_NAME=Blood Connect API
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=dev_blood_connect_super_secret_jwt_key_change_in_production_32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for production, SQLite async supported for local development/testing)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bloodconnect_db

# CORS Settings (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OTP Settings
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Administrator Management & Bootstrap Secret
# ADMIN_BOOTSTRAP_SECRET: Secret for break-glass administrative recovery/provisioning via X-Admin-Secret header.
# Must be a long, cryptographically random string in production. Keep confidential.
ADMIN_BOOTSTRAP_SECRET=

# INITIAL_ADMIN_PHONE_NUMBERS: Comma-separated list of 10-digit Indian phone numbers to provision as ADMIN on initial startup.
# NOTE: This setting is for initial bootstrap provisioning only. Once provisioned, database UserRole.ADMIN is the runtime
# source of truth. Removing a number from this variable will NOT demote an existing administrator.
INITIAL_ADMIN_PHONE_NUMBERS=

