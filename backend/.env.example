# Application Configuration
APP_NAME=Blood Connect API
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PUBLIC_API_URL=http://localhost:8000
SECRET_KEY=dev_blood_connect_super_secret_jwt_key_change_in_production_32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for production, SQLite async supported for local development/testing)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bloodconnect_db

# CORS Settings (comma-separated origins or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OTP Settings
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Administrator Management & Bootstrap Secret
ADMIN_BOOTSTRAP_SECRET=
INITIAL_ADMIN_PHONE_NUMBERS=

# Communication Strategy
NOTIFICATION_PROVIDER=mock
NOTIFICATION_PRIMARY_CHANNEL=whatsapp
NOTIFICATION_SMS_FALLBACK=True

# Meta WhatsApp Cloud API Configuration
WHATSAPP_PROVIDER=mock
WHATSAPP_NUMBER=919843883304
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev_wa_verify_token_change_in_production!
WEBHOOK_VERIFY_SIGNATURE=True

# Meta WhatsApp Templates (Configurable names)
WHATSAPP_TEMPLATE_AUTH_OTP=bloodconnect_auth_otp
WHATSAPP_TEMPLATE_BLOOD_REQUEST=bloodconnect_blood_request
WHATSAPP_TEMPLATE_REQUEST_ACCEPTED=bloodconnect_request_accepted
WHATSAPP_TEMPLATE_REQUEST_REJECTED=bloodconnect_request_rejected
WHATSAPP_TEMPLATE_REQUEST_CANCELLED=bloodconnect_request_cancelled
WHATSAPP_TEMPLATE_REQUEST_REMINDER=bloodconnect_request_reminder

# SMS Configuration (MSG91 / Configurable)
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BLDCON
MSG91_OTP_TEMPLATE_ID=
